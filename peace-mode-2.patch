     return mp_peace_active_host() ? g_remote_moves + MP_PEACE_WINDOW_AP : g_remote_moves;
 }
 
+// Host only: in peace mode the client has run ahead of the shared clock
+// (spent AP for turns that have not happened yet).  When the host is idle at
+// the main map, its input loop uses this to let the turn pass on its own
+// (the ordinary TIMEOUT auto-pause, which safe mode still blocks when hostiles
+// are in view), so world time keeps up with the client instead of freezing
+// until the host presses a key.  A host sitting in a menu doesn't reach that
+// loop, so the client can still run ahead by up to the window there.
+bool mp_peace_host_should_autowait()
+{
+    return mp_peace_active_host() && g_remote_moves < 0;
+}
+
