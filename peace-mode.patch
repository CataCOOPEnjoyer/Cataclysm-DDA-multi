+// ---------------------------------------------------------------------------
+// PEACE MODE ("мирний режим").  A shared, host-authoritative toggle either player
+// can flip (ACTION_COOP_PEACE_TOGGLE).  Off = the strict per-turn lockstep this
+// fork has always had ("бойовий режим").  On = the two players may drift apart
+// in time by up to MP_PEACE_WINDOW_AP action points in EITHER direction, so one
+// can browse a locker / sit in a menu while the other keeps walking, looting
+// and opening doors.
+//
+// Model: g_remote_moves (B) is the client's AP balance against the shared clock.
+//   B > 0  : the client is behind (time passed that it has not spent yet)
+//   B < 0  : the client is ahead  (it spent AP for turns that have not happened)
+// In peace mode the client is told it may spend B + WINDOW ("wire moves"), so it
+// can run up to WINDOW ahead; the host stops waiting for the client entirely
+// until B reaches +WINDOW (the client is a full window behind), and only then
+// falls back to the ordinary blocking lockstep wait.  Every action the client
+// makes still costs AP, so neither side gets free actions; they just don't have
+// to take them in alternation.
+//
+// Peace mode is suspended automatically (the pair falls back to plain lockstep
+// for that stretch) while the client is in a long activity (craft, read, wait,
+// sleep — those tick one grant per turn and must not be fed a banked window),
+// while fast-forward is running, and while the client is driving a vehicle.
+// Switching it either way resets B to 0 so combat always starts in sync.
+static constexpr int MP_PEACE_WINDOW_AP = 5000;
+static bool g_peace_mode = false;
+
+bool mp_peace_mode()
+{
+    return g_peace_mode;
+}
+
+// Host only: is the peace window in effect for the client right now?
+static bool mp_peace_active_host()
+{
+    if( !g_peace_mode || !is_hosting() || !remote_player_connected ) {
+        return false;
+    }
+    if( !g_partner_activity.empty() ) {
+        return false;
+    }
+    if( should_fast_forward() ) {
+        return false;
+    }
+    if( const npc *remote = g->critter_by_id<npc>( remote_player_npc_id ) ) {
+        if( remote->controlling_vehicle ) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// Host only: the move budget the client is told it may spend.  Identical to
+// g_remote_moves outside peace mode.
+static int mp_wire_moves()
+{
+    return mp_peace_active_host() ? g_remote_moves + MP_PEACE_WINDOW_AP : g_remote_moves;
+}
