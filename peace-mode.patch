+// ---------------------------------------------------------------------------
+// PEACE MODE toggle plumbing (state + rules: see MP_PEACE_WINDOW_AP above).
+//
+// Wire, both directions: {"type":"peace_mode","on":<bool>,"by":<name>}
+//  - client -> host: a request; the host applies it and echoes it to the client.
+//  - host -> client: the authoritative new value (also repeated as "peace" in
+//    every state packet, so a missed toggle self-heals on the next turn).
+
+// Set the mode; announce a change in the message log.  On the host this also
+// resyncs the client's balance and tells the client.  `by` is the name of the
+// player who flipped it ("" when only resyncing from a state packet).
+static void mp_peace_apply( bool on, const std::string &by )
+{
+    if( on == g_peace_mode ) {
+        return;
+    }
+    g_peace_mode = on;
+    mp_log( std::string( "[cdda-mp] PEACE-MODE: " ) + ( on ? "on" : "off" ) +
+            ( by.empty() ? std::string() : " by " + by ) );
+    if( is_hosting() ) {
+        // Start each mode in sync: no carried advance or bank either way.
+        g_remote_moves = 0;
+        if( server *srv = get_active_server() ) {
+            srv->post_broadcast( std::string( "{\"type\":\"peace_mode\",\"on\":" ) +
+                                 ( on ? "true" : "false" ) + ",\"by\":\"" +
+                                 json_escape_str( by ) + "\"}\n" );
+        }
+    }
+    const std::string who = by.empty() ? std::string() : " (" + by + ")";
+    if( on ) {
+        //~ %1$s is " (player name)" or empty, %2$d is the AP window.
+        add_msg( m_good, _( "Мирний режим увімкнено%1$s: кожен може діяти до %2$d ОД, не чекаючи партнера." ),
+                 who, MP_PEACE_WINDOW_AP );
+    } else {
+        //~ %s is " (player name)" or empty.
+        add_msg( m_warning, _( "Бойовий режим увімкнено%s: ходи суворо по черзі." ), who );
+    }
+    if( g ) {
+        g->invalidate_main_ui_adaptor();
+    }
+}
+
+// Host or client: an incoming {"type":"peace_mode",...} packet.
+static void mp_handle_peace_msg( const std::string &msg )
+{
+    try {
+        JsonValue jv = json_loader::from_string( msg );
+        JsonObject jo = jv.get_object();
+        jo.allow_omitted_members();
+        const bool on = jo.get_bool( "on", false );
+        const std::string by = jo.get_string( "by", std::string() );
+        mp_peace_apply( on, by );
+    } catch( const JsonError &e ) {
+        mp_log( "[cdda-mp] peace_mode parse error: " + std::string( e.what() ) );
+    }
+}
+
+// Keybound entry point (ACTION_COOP_PEACE_TOGGLE).  Zero AP, allowed while
+// locked, so either player can drop the pair into combat mode at any moment.
+void mp_peace_toggle()
+{
+    const bool partner = is_hosting() ? remote_player_connected : is_client_mode();
+    if( !partner ) {
+        add_msg( m_warning, _( "No co-op partner connected." ) );
+        return;
+    }
+    const bool want = !g_peace_mode;
+    const std::string me = get_avatar().get_name();
+    if( is_hosting() ) {
+        mp_peace_apply( want, me );
+    } else {
+        // The host decides; its echo flips our flag and prints the message.
+        client_send( std::string( "{\"type\":\"peace_mode\",\"on\":" ) +
+                     ( want ? "true" : "false" ) + ",\"by\":\"" + json_escape_str( me ) + "\"}" );
+    }
+}
+
+// Client: in peace mode a grant can carry a whole window of AP.  While the
+// avatar is in an activity, never let more than one turn per represented turn
+// through, or the activity would progress many turns at once.
+static int mp_peace_clamp_moves_for_activity( int moves, int turns )
+{
+    if( !g_peace_mode || !is_client_mode() || moves <= 0 || !get_avatar().activity ) {
+        return moves;
+    }
+    const int cap = std::max( 1, get_avatar().get_speed() ) * std::max( 1, turns );
+    return std::min( moves, cap );
+}
+
+void mp_peace_clamp_local_activity( Character &u )
+{
+    if( !u.is_avatar() || !u.activity ) {
+        return;
+    }
+    const int clamped = mp_peace_clamp_moves_for_activity( u.get_moves(), 1 );
+    if( clamped != u.get_moves() ) {
+        mp_log( "[cdda-mp] PEACE-CLAMP: activity " + u.activity.id().str() + " moves " +
+                std::to_string( u.get_moves() ) + "->" + std::to_string( clamped ) );
+        u.set_moves( clamped );
+    }
+}
